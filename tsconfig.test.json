{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "src/types.ts",
    "src/utils/**/*.ts",
    "tests/**/*.ts"
  ]
}
